[source]
swsource=1
sourcelist=None
source_x0=None
source_y0=None
source_z0=None
sigma_x=None
sigma_y=None
sigma_z=None
strength=None
swvmr=None
line_x=None
line_y=None
line_z=None


[chemistry]
swchemistry = None

lifetime = 1e30 # Set to a very large value to effectively disable chemical decay,

# Target-reference-height formulation
# If enabled, the code checks whether the lowest model level is below
# the estimated roughness sublayer height z_star.
sw_adapt_ref_height = 1

# If false, the code uses c_low directly when z_low >= z_star,
# and only interpolates to z_ref when z_low < z_star.
# If true, the code always uses the selected reference height.
sw_force_ref_height = 0

# Definition of the target reference height used when interpolation is required.
# true  : z_ref = z_fixed
# false : z_ref = rsl_ratio * z0m
sw_const_ref_height = 1
z_fixed = 20.0

# Roughness sublayer estimate:
# z_star = rsl_ratio * z0m.
# With the manuscript assumption h_c = 10 z0m,
# rsl_ratio = 20 corresponds to z_star = 2 h_c.
rsl_ratio = 20.0

# Levels used to compute c_* for target-height interpolation.
# true  : use kstart and kstart+1
# false : use the two LES levels bracketing z_ref
sw_use_lowest_levels = 0


[deposition]
swdeposition = None
use_depac = 1  # true: use DEPAC | false: use original resistance scheme

# Compensation point override [only used if use_depac = true]
sw_override_ccomp = 1  # true: fix ccomp_tot to ccomp_override_value (disables DEPAC compensation point calculation)
ccomp_override_value = 0.0  # fixed compensation point [ug m-3] (used if sw_override_ccomp = true)

# DEPAC inputs [only used if use_depac = true]
c_ave_prev_nh3 = 5.0  # long-term average NH3 concentration [ug m-3]; drives stomatal compensation point via gamma_stom = 362 * c_ave_prev_nh3 * 4.7 * exp(-0.071*T)
iratns = 2  # NH3/SO2 ratio regime: 1=low (<0.5 ppb SO2 or 0.02<=ratio<=2) | 2=high (ratio>2) | 3=very low (ratio<0.02)
hlaw = 61.0  # effective Henry's law constant [M atm-1]
react = 0.0  # reactivity factor [-] (0.0 for NH3)

# Wetness indicators per tile: 0=dry | 1=wet | 9=snow
nwet_veg = 0  # vegetation tile
nwet_soil = 0  # bare soil tile
nwet_wet = 1  # wet skin tile (intercepted water); always 1 by definition

[buffer]
swbuffer=1
zstart=2000.0
sigma=0.00223
beta=2.0

[time]
endtime=None
dt=6.0
dtmax=30.0
savetime=3600
outputiter=5
adaptivestep=true
starttime=0
rkorder=3
datetime_utc=None

[stats]
swstats=1
sampletime=60
swtendency = true
xymasklist= None

[budget]
swbudget=1

[cross]
swcross=1
sampletime=60
crosslist=None
