xy=2,6,10,14,18,22,26,30,34,38
yz=0,5,10,15,20,890,900,910,1390,1400,1410,2390,2400,2410,3390,3400,3410,4390,4400,4410,5390,5400,5410,6390,6400,6410,7390,7400,7410,7660,7665,7670,7675,7680
xz=1920.0,3640.0

[dump]
