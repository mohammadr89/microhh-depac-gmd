# Base jaenschwalde .ini file. All `None` values are set by `jaenschwalde_input.py`.

[master]
npx=96
npy=48

[grid]
itot=None
jtot=None
ktot=None
lat=None
lon=None
xsize=None.
ysize=None.
zsize=None.
swspatialorder=2

[advec]
swadvec=2i5
cflmax=1.0
fluxlimit_list=None

[limiter]
limitlist=None

[diff]
swdiff=smag2
dnmax=0.4

[thermo]
swthermo=moist
swbasestate=anelastic
thvref0=300
pbot=101325.

[force]
swlspres=0
swls=0
swwls=0
swnudge=1
swtimedep_nudge=0
nudgelist=qt

[boundary]
swboundary=None
mbcbot=noslip
mbctop=freeslip
sbcbot=flux
sbcbot[thl]=dirichlet
sbcbot[qt]=dirichlet
sbctop=neumann
sbot=0
sbot[qt]=0.1e-3
sbot[thl]=-1
stop=0
stop[thl]=-1
stop[qt]=-2.8e-7
z0m=0.75
z0h=0.075
swtimedep=None
timedeplist=None
scalar_outflow=None
flow_direction[north]=outflow
flow_direction[east]=outflow
flow_direction[south]=outflow
flow_direction[west]=inflow
thl=dirichlet
qt=dirichlet

[land_surface]
swhomogeneous=0
swfreedrainage=1
swtilestats=1
swtilestats_column=1
switerseb=0
swwater=1
ktot=4

#gD=0.0
#c_veg=0.95
#lai=2.6
#rs_veg_min=100
#rs_soil_min=50
#lambda_stable=10.0
#lambda_unstable=10.0
#cs_veg=0

[column]
swcolumn=0
sampletime=60
coordinates[x]=3900
coordinates[y]=1920
columnlist=u,v

[radiation]
swradiation=None
swtimedep_prescribed=1
emis_sfc=0.97
max_rad=None

[fields]
visc=1.e-5
svisc=1.e-5
slist=None
rndseed=2
rndamp[thl]=0.1
rndz=300.0
rndexp=2.0

[source]
swsource=0
sourcelist=None
source_x0=None
source_y0=None
source_z0=None
sigma_x=None
sigma_y=None
sigma_z=None
strength=None
swvmr=None
line_x=None
line_y=None
line_z=None

[chemistry]
swchemistry = None

[deposition]
swdeposition = None
use_depac=1     # Toggle between DEPAC and original method
sw_override_ccomp=0        # 0=disabled, 1=enabled
ccomp_override_value=0.0   # Value to use when override is enabled
c_ave_prev_nh3 = 5.0
iratns=2
hlaw=61.0
react=0.0
nwet_veg=0
nwet_soil=0
nwet_wet=1

[buffer]
swbuffer=1
zstart=2000.0
sigma=0.00223
beta=2.0

[time]
endtime=None
dt=6.0
dtmax=30.0
savetime=3600
outputiter=5
adaptivestep=true
starttime=0
rkorder=3
datetime_utc=None

[stats]
swstats=1
sampletime=60
swtendency = true
xymasklist= None

[budget]
swbudget=1

[cross]
swcross=1
sampletime=60
crosslist=None
# crosslist=u,v,flux_nh3,flux_inst,nh3,nh3_path,vdnh3,vdnh3_soil,vdnh3_wet,vdnh3_veg,ra,rb,obuk,ustar,ccomp_tot,cw,cstom,csoil_eff,cw_out,cstom_out,csoil_out,rc_tot,rc_eff,ra_soil,rb_soil,obuk_soil,ustar_soil,ra_wet,rb_wet,obuk_wet,ustar_wet,ra_veg,rb_veg,obuk_veg,ustar_veg,rh_surface, T_surface, c_diff_flux, flux_nh3_mol_ha_yr
xy=2,6,10,14,18,22,26,30,34,38
yz=890,900,910,1390,1400,1410,2390,2400,2410,3390,3400,3410,4390,4400,4410,5390,5400,5410,6390,6400,6410,7390,7400,7410
xz=1920.0

[dump]
swdump=0
sampletime=60
dumplist=u,v
